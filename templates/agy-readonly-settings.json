{
  "permissions": {
    "allow": [
      "command(cd)",
      "command(pwd)",
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(grep)",
      "command(shasum)",
      "command(sha256sum)",
      "command(git status)",
      "command(git rev-parse)"
    ],
    "deny": [
      "command(rm)",
      "command(mv)",
      "command(sed -i)",
      "command(rg)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git push)",
      "command(git commit)",
      "command(git checkout)",
      "command(ssh)",
      "command(scp)",
      "command(rg --pre)",
      "command(rg --pre-glob)",
      "command(rg --search-zip)",
      "command(rg -z)",
      "command(git diff --output)",
      "command(git log --output)",
      "command(git show --output)",
      "command(git diff --ext-diff)",
      "command(git diff --textconv)",
      "command(git log --ext-diff)",
      "command(git show --ext-diff)",
      "command(git -c)",
      "command(cat ~/.ssh)",
      "command(cat ~/.aws)",
      "command(cat ~/.config)",
      "command(cat .env)",
      "command(grep ~/.ssh)",
      "command(grep ~/.aws)",
      "command(head ~/.ssh)",
      "command(tail ~/.ssh)"
    ]
  }
}
